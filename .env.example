ALPACA_TRADING_URL=https://paper-api.alpaca.markets/v2 # Trading API base URL
ALPACA_KEY=your_alpaca_api_key # Alpaca API key
ALPACA_SECRET=your_alpaca_api_secret # Alpaca API secret
ALPACA_DATA_URL=https://data.alpaca.markets/v2 # Market data API base URL

LLM_MODEL=gpt-6.1-sol # Model for classification and research
LLM_REASONING_EFFORT=low # Research reasoning effort; first pass always uses low
LLM_CONCURRENCY=4 # Maximum simultaneous model calls
LLM_MIN_REMAINING_PERCENT=50 # Stop new calls below this remaining usage percentage
LLM_RESEARCH_ENABLED=false # Enable web research after classification

RUST_LOG=info # Log level; debug includes prompts and Codex output
